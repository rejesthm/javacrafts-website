# GoHighLevel / n8n Inbound Webhook URL.
# Server-only secret — do NOT prefix with NEXT_PUBLIC_ (that would ship the URL
# to the browser, letting anyone spam your CRM/Sheet). Set this in your hosting
# environment (Vercel/host project settings) AND in a local .env for dev.
# Receives both full order submissions and pre-checkout lead captures; the
# payload's `eventType` ("checkout_lead_capture") tells them apart.
GHL_WEBHOOK_URL=

# Admin-only dashboard access. Defaults to this email in code if unset.
ADMIN_EMAIL=

# Firebase Admin SDK — server-only. Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Firebase Web SDK — public browser config for Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
