rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPublicSiteSetting(documentId) {
      return documentId in ['product', 'testimonials', 'delivery'];
    }

    match /siteSettings/{documentId} {
      allow read: if isPublicSiteSetting(documentId);
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /checkoutLeads/{leadId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
